# LOCAL LOOPBACK DEMO ONLY. Replace every credential before use. Never expose
# these public examples on a network, and never set AGENTSQL_INSECURE here.

VERSION=v0.4.0
GOPROXY=https://proxy.golang.org,direct

# demo/reset.sh and demo/reset.ps1 set an empty value to today's UTC date.
# Before a manual `docker compose up`, export a real YYYY-MM-DD value yourself.
DEMO_ANCHOR_DATE=

DEMO_PG_PORT=5432
DEMO_MYSQL_PORT=3306
DEMO_GATEWAY_PORT=17880

# PostgreSQL init owner and MySQL init root. LOCAL DEMO VALUES: REPLACE THEM.
DEMO_PG_OWNER_USER=agentsql_demo_owner
DEMO_PG_OWNER_PASSWORD=LocalPgOwner_Replace_2026
DEMO_MYSQL_ROOT_PASSWORD=LocalMySqlRoot_Replace_2026

# Read-only business accounts stored by the demo control plane. REPLACE BOTH.
# Init scripts accept only conservative ASCII: A-Z a-z 0-9 . _ ~ ! @ # % ^ + = -
AGENTSQL_DEMO_PG_PASSWORD=LocalPgReadonly_Replace_2026
AGENTSQL_DEMO_MYSQL_PASSWORD=LocalMySqlReadonly_Replace_2026

# Exactly 32 ASCII bytes. This committed local example is public: REPLACE IT.
AGENTSQL_SECRET=L0calDemoOnly_2026_ReplaceMe_N0w
AGENTSQL_ADMIN_USER=admin
AGENTSQL_ADMIN_PASSWORD=LocalDemoAdmin_Replace_2026

# Valid AgentSQL key-shaped LOCAL EXAMPLES. They are public and MUST be replaced
# before any non-loopback deployment.
AGENTSQL_DEMO_RO_KEY=asql_cm8tZGVtby1rZXktcmVwbGFjZS0wMDAwMDAwMDAwMDA
AGENTSQL_DEMO_DML_KEY=asql_ZG1sLWRlbW8ta2V5LXJlcGxhY2UtMDAwMDAwMDAwMDA
