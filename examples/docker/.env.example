# Image/application version used by Docker Compose.
VERSION=v0.2.0

# Optional Go module proxy used only while building the image. Leave the
# default for normal networks; set to https://goproxy.cn,direct on restricted
# networks where proxy.golang.org is unreachable.
GOPROXY=https://proxy.golang.org,direct

# Required before deployment. Bash: openssl rand -base64 24
# PowerShell: $b=[byte[]]::new(24); $r=[System.Security.Cryptography.RandomNumberGenerator]::Create(); $r.GetBytes($b); [Convert]::ToBase64String($b); $r.Dispose()
# This encrypts business datasource passwords; it is distinct from the
# PostgreSQL metadata DSN password. Keep it stable and back it up with the
# metadata store. Never commit the real value.
AGENTSQL_SECRET=

AGENTSQL_ADMIN_USER=admin
# Required before deployment. Use a unique passphrase of at least 12 characters.
# Generate one with a password manager or: openssl rand -base64 24
# Never commit the real value.
AGENTSQL_ADMIN_PASSWORD=

# Optional PostgreSQL control plane. These variables are read only when
# docker-compose.controlplane.yml is explicitly loaded with -f. That file's
# ${VAR:?message} form rejects an unset or empty required variable before any
# container is created. Keep passwords and DSNs empty in this committed file.
AGENTSQL_METADATA_DB=agentsql_metadata
AGENTSQL_AUDIT_DB=agentsql_audit
AGENTSQL_METADATA_MIGRATION_USER=agentsql_meta_migrator
AGENTSQL_METADATA_MIGRATION_PASSWORD=
AGENTSQL_AUDIT_MIGRATION_USER=agentsql_audit_migrator
AGENTSQL_AUDIT_MIGRATION_PASSWORD=
AGENTSQL_METADATA_DB_PORT=55432
AGENTSQL_AUDIT_DB_PORT=55433

# Use the migration-owner DSNs only while running migrate-sqlite-to-postgres.
# After migration and GRANTs, replace both values with least-privilege runtime
# account DSNs before starting agentsql-controlplane. Never commit real DSNs.
AGENTSQL_STORE_METADATA_DSN=
AGENTSQL_STORE_AUDIT_DSN=
