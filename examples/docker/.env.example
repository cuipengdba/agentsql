# Image/application version used by Docker Compose.
VERSION=v0.1.0

# Required before deployment. Bash: openssl rand -base64 24
# PowerShell: $b=[byte[]]::new(24); $r=[System.Security.Cryptography.RandomNumberGenerator]::Create(); $r.GetBytes($b); [Convert]::ToBase64String($b); $r.Dispose()
# Keep it stable and back it up with agentsql.db. Never commit the real value.
AGENTSQL_SECRET=

AGENTSQL_ADMIN_USER=admin
# Required before deployment. Use a unique passphrase of at least 12 characters.
# Generate one with a password manager or: openssl rand -base64 24
# Never commit the real value.
AGENTSQL_ADMIN_PASSWORD=
