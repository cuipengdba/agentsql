# Image/application version used by Docker Compose.
VERSION=v0.1

# Replace this value before deployment. The value below is exactly 32 bytes;
# AGENTSQL_SECRET must remain stable or stored datasource passwords cannot be decrypted.
AGENTSQL_SECRET=0123456789abcdef0123456789abcdef

AGENTSQL_ADMIN_USER=admin
AGENTSQL_ADMIN_PASSWORD=CHANGE_ME_AgentSQL_Admin_2026!
