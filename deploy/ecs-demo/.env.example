# AgentSQL Live Demo environment — copy to .env and replace every value.
# Compose auto-loads .env; never commit it. All credentials are demonstration-only.

# Fixed anchor date for the generated demo history (YYYY-MM-DD). Set to the
# current date on first deploy; the demo control plane seeds a fixed window
# around this date.
DEMO_ANCHOR_DATE=2026-09-30

# Database init-time owner/root accounts.
DEMO_PG_OWNER_PASSWORD=REPLACE_with_pg_owner_pw
DEMO_MYSQL_ROOT_PASSWORD=REPLACE_with_mysql_root_pw

# Read-only business accounts used by the demo agents.
AGENTSQL_DEMO_PG_PASSWORD=REPLACE_with_pg_ro_pw
AGENTSQL_DEMO_MYSQL_PASSWORD=REPLACE_with_mysql_ro_pw

# Exactly 32 ASCII bytes. Generate with: openssl rand -hex 16
AGENTSQL_SECRET=REPLACE_exactly_32_bytes_0000

# Console admin login.
AGENTSQL_ADMIN_USER=admin
AGENTSQL_ADMIN_PASSWORD=REPLACE_with_admin_pw

# Agent API keys — asql_ prefix + URL-safe base64 of exactly 32 bytes. Generate:
#   printf 'asql_%s' "$(openssl rand -base64 32 | tr '+/' '-_' | tr -d '=')"
AGENTSQL_DEMO_RO_KEY=asql_REPLACE_ro_key
AGENTSQL_DEMO_DML_KEY=asql_REPLACE_dml_key
