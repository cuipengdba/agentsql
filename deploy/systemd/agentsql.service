[Unit]
Description=AgentSQL AI-native database security gateway
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=agentsql
Group=agentsql
EnvironmentFile=-/etc/agentsql/agentsql.env
# YashanDB client is NOT bundled. If you use YashanDB data sources, download the client from the vendor and uncomment:
# Environment="LD_LIBRARY_PATH=/path/to/your/yashandb-client/lib"
ExecStart=/usr/local/bin/agentsql serve -c /etc/agentsql/config.yaml
Restart=on-failure
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/agentsql

[Install]
WantedBy=multi-user.target
