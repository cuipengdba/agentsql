# 阶段 B：备案、DNS、安全组与防火墙就绪后启用。
# 与 Caddyfile.common 一起安装到 /etc/caddy/；域名站点会自动申请证书并将 HTTP 跳转到 HTTPS。
{
	email 87326549@qq.com
}

import /etc/caddy/Caddyfile.common

agentsql.cn {
	import agentsql_static

	@demo_console path /demo/console /demo/console/
	redir @demo_console {$DEMO_PUBLIC_URL:https://demo.agentsql.cn/} 302

	@html path / /index.html /demo /demo/ /demo/index.html
	header @html Cache-Control "no-cache"

	@mutable path /assets/app.js /assets/app.css /assets/og-cover.png /favicon.svg /apple-touch-icon.png /assets/apple-touch-icon.png /assets/screenshots/*.png
	header @mutable Cache-Control "public, max-age=0, must-revalidate"

	@versioned_docs path /assets/docs/*.pdf
	header @versioned_docs Cache-Control "public, max-age=31536000, immutable"

	header {
		Strict-Transport-Security "max-age=300"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'; upgrade-insecure-requests"
	}
}

www.agentsql.cn {
	import agentsql_security
	header {
		Strict-Transport-Security "max-age=300"
		Content-Security-Policy "default-src 'none'; base-uri 'none'; frame-ancestors 'none'"
	}
	redir https://agentsql.cn{uri} 301
}

# 独立源让根路径型控制台保持完整，不对外暴露 7780/17880。
# 此站点不启用 access log；上游必须只监听回环。
demo.agentsql.cn {
	import agentsql_demo_proxy
	header Strict-Transport-Security "max-age=300"
}
