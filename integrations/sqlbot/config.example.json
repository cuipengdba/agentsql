{
  "version": 1,
  "endpoint": "https://your-agentsql.example/mcp",
  "timeout_seconds": 30,
  "min_interval_seconds": 0.6,
  "bindings": [
    {
      "workspace_id": 1,
      "datasource_name": "AgentSQL PostgreSQL",
      "dialect": "pg",
      "datasource_id": "ds-example",
      "schema": "public",
      "numeric_columns": ["id", "total", "amount"],
      "key_env": "AGENTSQL_SQLBOT_READONLY_KEY"
    }
  ]
}
