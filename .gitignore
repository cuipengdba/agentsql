# AgentSQL .gitignore
data/
*.db
*.db-journal
*.db-wal
*.db-shm

# Go
*.exe
*.exe~
*.dll
*.so
*.dylib
bin/
dist/
.gocache/

# Web
web/node_modules/
web/dist/
# 前端构建产物由 internal/webui 的 go:embed 内嵌、必须随仓库发布,显式放行
!internal/webui/dist/
!internal/webui/dist/**

# Env / secrets
.env
demo/demo.env
*.local

# IDE / OS
.idea/
.vscode/
.DS_Store
Thumbs.db

# Local Docker CLI / buildx state
.docker-config/

artifacts/
.tmp/
